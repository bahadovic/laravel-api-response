{
  "name": "bahadovic/laravel-api-response",
  "description": "A fluent, standard API Response Builder for Laravel.",
  "keywords": [
    "laravel",
    "api",
    "response",
    "json",
    "formatter",
    "api-response",
    "rest",
    "bahadovic"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Amirbahador Hosseini",
      "email": "amirbahador1221@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0",
    "illuminate/pagination": "^10.0|^11.0|^12.0",
    "illuminate/validation": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.0|^11.0",
    "larastan/larastan": "^2.0|^3.0",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Bahadovic\\ApiResponse\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bahadovic\\ApiResponse\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Bahadovic\\ApiResponse\\ApiResponseServiceProvider"
      ],
      "aliases": {
        "ApiResponse": "Bahadovic\\ApiResponse\\Facades\\ApiResponse"
      }
    },
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=2G",
    "format": "pint"
  }
}